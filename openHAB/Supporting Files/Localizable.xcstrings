    },
    "command_item_footer" : {
      "comment" : "Footer text for the Command Item section in home settings, explaining the feature's purpose.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wenn sich der Zustand des gewählten Items auf dem Server ändert, führt die App es als Befehl aus."
          }
        }
      }
    },
    "command_item_info_body" : {
      "comment" : "A body text for the CommandItemInfoSheet.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Das Befehlselement ist ein Fernsteuerungskanal vom Stromkreis-Server zu dieser App. Die App beobachtet das gewählte Item über den Echtzeit-Ereignis-Stream des Servers. Sobald sich der Zustand des Items ändert, führt die App den neuen Wert sofort als Befehl aus – ohne Push-Benachrichtigung.\n\nUnterstützte Befehle: Navigation zu einer Sitemap oder Main UI-Seite, Senden eines Befehls an ein anderes Item, Auslösen einer Regel, Anzeigen des Bildschirmschoners, Text-to-Speech und Anpassen der Bildschirmhelligkeit.\n\nEs wird dasselbe Befehlsformat verwendet wie bei Stromkreis-Push-Benachrichtigungsaktionen."
          }
        }
      }
    },
    "Configure" : {
      "comment" : "A label displayed when a widget slot is not configured.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Konfigurieren"
          }
        }
      }
    },
